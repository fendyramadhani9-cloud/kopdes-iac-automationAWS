# ==============================================================================
# KopDes Merah Putih - Environment Configuration
# Template Konfigurasi AWS Native & On-Premise / Local
# ==============================================================================

# Application Settings
APP_NAME="KopDes Merah Putih"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://kopdes-alb-123456789.us-east-1.elb.amazonaws.com

# Database Configuration (Amazon RDS MySQL / MariaDB)
# Di AWS: Gunakan endpoint RDS (misal: kopdes-mysql.c123456789.us-east-1.rds.amazonaws.com)
# Di Local: Gunakan 127.0.0.1 atau SQLite (DB_CONNECTION=sqlite)
DB_CONNECTION=mysql
DB_HOST=kopdes-db.cxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=kopdes
DB_USER=kopdes_admin
DB_PASS=CHANGE_TO_SECURE_PASSWORD

# Load Balancer & Auto Scaling Awareness (AWS ALB / ASG)
SERVER_NODE=WEB-ASG
ALB_DNS_NAME=kopdes-alb-123456789.us-east-1.elb.amazonaws.com
HAPROXY_STATUS=ONLINE

# Amazon Simple Email Service (SES) Configuration
# Pengiriman email laporan rekapitulasi ekonomi secara otomatis
AWS_REGION=us-east-1
SES_ENABLED=true
SES_SENDER_EMAIL=noreply@kopdes.id
SES_RECIPIENT_EMAIL=admin@kopdes.id
